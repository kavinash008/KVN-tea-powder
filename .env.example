# =================================================================
# KVN TEAPOWDER - PRODUCTION ENVIRONMENT VARIABLES (Vercel)
# =================================================================

# 1. MongoDB Atlas Connection (Recommended for permanent production database)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=kvn_store

# 2. Administrator Authentication
# Passcode used by Kavinash to log into the Admin Dashboard
ADMIN_PASSWORD=kavin008

# 3. Cryptographic JWT Secret
JWT_SECRET=kvn-teapowder-production-secret-key-2026

# 4. UPI Merchant Payment Configuration (Optional fallback if configured in Admin Settings DB)
MERCHANT_UPI_ID=
MERCHANT_UPI_NAME=KVN Tea Powder

# 5. Official Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=kvn_payment_confirmed
WHATSAPP_API_VERSION=v21.0

# 6. Cloudinary Signed Media Storage (Optional for payment screenshots / product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kvn_products
